{
  "name": "rpgo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"bun run --cwd apps/server dev\" \"bun run --cwd apps/web dev\"",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/server build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "migrate": "bun run --cwd apps/server migrate",
    "seed": "bun run --cwd apps/server seed",
    "start": "bun run --cwd apps/server start",
    "docs:check": "bun run scripts/check-docs.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "^1.2.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0"
  }
}
