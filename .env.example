# HTTP server
PORT=3001
WEB_ORIGIN=http://localhost:5173

# SQLite database file (relative to apps/server or absolute)
DATABASE_PATH=../../data/rpgo.sqlite

# Local OpenAI-compatible inference server
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local-development
LLM_MODEL=qwen3.5-2b-instruct
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1200
LLM_ENABLED=true

# Set to true to include raw (sanitized) LLM responses in diagnostics
LLM_DEBUG=false

# Seeded randomness for deterministic development (optional)
GAME_SEED=
